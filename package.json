{
  "name": "vibe-pipeline",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run build && bun run server/index.ts",
    "server": "bun run server/index.ts",
    "server:e2e": "cross-env PORT=3101 bun run server/index.ts",
    "build": "bun run scripts/with-build-version.ts -- tsc -b && bun run scripts/with-build-version.ts -- vite build",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "test:e2e:real": "playwright test --config=tests/e2e/playwright.real.config.ts"
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "otpauth": "^9.5.1",
    "qrcode-svg": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@playwright/test": "^1.59.1",
    "@types/bun": "^1.1.12",
    "@types/qrcode-svg": "^1.1.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "cross-env": "^10.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-precaching": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
